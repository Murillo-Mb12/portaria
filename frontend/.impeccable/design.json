 "narrative": {
  "northStar": "O Console da Portaria",
  "overview": "Software profissional de portaria no padrão dos sistemas de controle de acesso: barra institucional azul com o emblema SSVP, menu sóbrio, painéis com cabeçalho, tabelas densas e componentes retangulares.",
  "keyCharacteristics": [
   "Barra azul SSVP com emblema e filete vermelho.",
   "Fonte do sistema operacional.",
   "Painéis com faixa de cabeçalho.",
   "Componentes retangulares.",
   "Tabelas densas com números tabulares."
  ],
  "rules": [
   {
    "name": "A Regra do Filete",
    "body": "O vermelho SSVP nunca preenche áreas: é filete e emblema.",
    "section": "colors"
   },
   {
    "name": "A Regra do Azul que Comanda",
    "body": "O azul marca onde se está e o que fazer; nada mais é azul preenchido.",
    "section": "colors"
   }
  ],
  "dos": [
   "Do usar o emblema SSVP inteiro, sem recortar nem recolorir.",
   "Do colocar cada bloco de conteúdo num painel com faixa de cabeçalho.",
   "Do manter controles com 40-44 px e texto de no mínimo 13 px (14 px em rótulos)."
  ],
  "donts": [
   "Don't usar botões em pílula, neutros creme ou cartões amplos com ícone em quadradinho.",
   "Don't colocar subtítulo explicativo sob o título de cada página nem saudações.",
   "Don't preencher áreas com o vermelho SSVP.",
   "Don't usar caracteres de texto ou emoji como ícones."
  ]
 }
