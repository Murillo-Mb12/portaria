 "narrative": {
  "northStar": "O Balcão Acolhedor",
  "overview": "Um sistema de gestão no formato que todo mundo já conhece, com o acabamento de Notion/Trello e a acessibilidade do gov.br, em neutros quentes, letra grande e etiquetas coloridas.",
  "keyCharacteristics": [
   "Cânone de sistemas de gestão, sem enfeites temáticos.",
   "Neutros quentes e cartões brancos com borda de 1px.",
   "Atkinson Hyperlegible.",
   "Botões em pílula, campos de 44 px e foco âmbar.",
   "Etiquetas coloridas por objetivo e perfil."
  ],
  "rules": [
   {
    "name": "A Regra da Cor que Age",
    "body": "A cor de marca aparece só onde há ação ou seleção.",
    "section": "colors"
   },
   {
    "name": "A Regra da Etiqueta",
    "body": "Objetivo e perfil são sempre etiquetas coloridas.",
    "section": "colors"
   },
   {
    "name": "A Regra do Mínimo de 14",
    "body": "Nenhum texto da interface fica abaixo de 14 px.",
    "section": "typography"
   }
  ],
  "dos": [
   "Do usar a cor de marca só em ação e seleção.",
   "Do manter campos e botões com 44 px de altura e texto de no mínimo 14 px.",
   "Do colocar a ação de envio no fim do formulário, à direita.",
   "Do mostrar objetivo e perfil como etiquetas coloridas.",
   "Do trocar as variáveis --marca pela cor do logotipo do LSVP quando ele chegar."
  ],
  "donts": [
   "Don't fazer a interface parecer sistema frio de empresa.",
   "Don't usar faixas coloridas laterais.",
   "Don't usar caracteres de texto ou emoji como ícones.",
   "Don't inventar logotipo ou cores oficiais do LSVP."
  ]
 }
